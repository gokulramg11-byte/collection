# CinePulse India Backend Environment Variables
# Copy to .env and fill with real credentials. NEVER commit .env.

# Supabase (Backend / GitHub Actions uses service role key ONLY on server-side)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# TMDB API (Movie metadata & posters ONLY — never treated as authoritative box-office)
TMDB_API_KEY=your-tmdb-v3-api-key
TMDB_READ_ACCESS_TOKEN=your-tmdb-v4-read-token

# Authorized Box-Office Data Feeds (optional; disabled adapters are skipped gracefully)
LICENSED_FEED_API_KEY=
LICENSED_FEED_BASE_URL=
PERMITTED_RSS_URLS=
MANUAL_IMPORT_DIR=./data/manual_imports

# Runtime & Timezone
APP_ENV=production
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=Asia/Kolkata
DRAFT_EXPIRY_HOURS=48
CONFLICT_THRESHOLD_PCT=5.0
