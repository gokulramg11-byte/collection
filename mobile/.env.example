# CinePulse India Flutter Environment Configuration
# Pass via --dart-define-from-file=.env (NEVER commit real secrets or service_role keys!)

# Supabase (ONLY publishable/anon key — NEVER service_role key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Official X API OAuth 2.0 PKCE (Public Native Client — NO client secret embedded)
X_CLIENT_ID=your-x-oauth2-client-id
X_REDIRECT_URI=cinepulse://oauth/x
